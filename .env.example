# ===================================================
# SMART CITY COMPLAINT MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# Node Server Port & Environment
PORT=5000
NODE_ENV=production

# ---------------------------------------------------
# OPTION A: Cloud MySQL Connection String (Render / TiDB / Aiven / Railway)
# If DATABASE_URL is set, it will be prioritized over individual DB_* parameters.
# ---------------------------------------------------
# DATABASE_URL=mysql://username:password@hostname:3306/smart_complaint?ssl-mode=REQUIRED
# DB_SSL=true

# ---------------------------------------------------
# OPTION B: Discrete MySQL Connection Parameters (Local / VPS / Docker)
# ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=smart_complaint
DB_SSL=false

# ---------------------------------------------------
# Session Security
# Generate a random long string for production cookie signing
# ---------------------------------------------------
SESSION_SECRET=replace_with_a_long_random_secret_string_32_chars_or_more

# ---------------------------------------------------
# Seed Administrator Credentials (Created automatically on 'npm run db:init')
# ---------------------------------------------------
ADMIN_NAME=Municipal Administrator
ADMIN_EMAIL=admin@smartcity.gov
ADMIN_PASSWORD=change_this_admin_password_in_production

